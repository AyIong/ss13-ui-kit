@font-face {
  font-family: "{{name}}";
  font-style: normal;
  font-weight: 400;
  font-display: block;
  src: url("{{fontsUrl}}/{{name}}.woff2") format("woff2");
}

.{{prefix}} {
  display: var(--fa-display, inline-block);
  font-family: {{name}};
  font-feature-settings: normal;
  font-style: normal;
  font-synthesis: none;
  font-variant: normal;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  text-rendering: auto;
  width: var(--fa-width, 1.25em);
  -webkit-font-smoothing: antialiased;
}

.{{prefix}}:before {
  content: var(--{{prefix}});
}

{{#each codepoints}}
.{{@key}} {
  --{{../prefix}}: "\\{{codepoint this}}";
}

{{/each}}



