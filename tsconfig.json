{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "ScriptHost"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    /* Set to true when lib will be ready */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "tgui-core/*": ["./lib/*.ts", "./lib/*.tsx"],
      "@common/*": ["./lib/common/*.ts"],
      "@components": ["./lib/components/index.ts"],
      "@hooks": ["./lib/hooks/index.ts"],
      "@stories/*": ["./stories/*.ts", "./stories/*.tsx", "./lib/components/*.stories.tsx"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    /* Linting */
    "strict": false,
    "strictNullChecks": true,
    "target": "ESNext",
    "useDefineForClassFields": true
  },
  "include": ["lib", "global.d.ts", "stories", ".storybook"]
}
